          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Optional[list[Optional[str]]]: both the array and its items may be null.",
      "title": "Optional Values Nullable Items"
    },
    "optional_values_list_type": {
      "description": "Nullable array (list-form type) with nullable items; null must appear once in the type.",
      "items": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
