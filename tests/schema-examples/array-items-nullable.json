    "values": {
      "description": "list[Optional[str]]: items may be null, the array may not.",
      "items": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "title": "Values",
      "type": "array"
    },
    "values_oneof": {
      "description": "Nullable items using oneOf.",
      "items": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "title": "Values Oneof",
      "type": "array"
    },
    "values_list_type": {
      "description": "Nullable items using a list-form type.",
      "items": {
        "type": [
          "string",
          "null"
        ]
      },
      "title": "Values List Type",
      "type": "array"
    },
