        "anyOf": [
          {
            "type": "null"
          }
        ]
      },
      "type": "array"
    },
    "multi_type_nullable_items": {
      "description": "Items with several list-form types or null.",
      "items": {
        "anyOf": [
          {
            "type": [
              "string",
              "integer"
            ]
          },
          {
            "type": "null"
          }
        ]
      },
      "type": "array"
    },
    "titled_null_items": {
      "description": "A null option with extra keywords is still null.",
