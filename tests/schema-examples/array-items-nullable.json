        "$ref": "#/$defs/Tag",
        "type": [
          "object",
          "null"
        ]
      },
      "type": "array"
    },
    "constraint_and_null_items": {
      "description": "The sibling type object rules out the null entry in the anyOf: items are objects only.",
      "items": {
        "anyOf": [
          {
            "required": [
              "name"
            ]
          },
          {
            "type": "null"
          }
        ],
        "properties": {
          "name": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "untyped_nullable_items": {
      "description": "No type keyword: items still make this an array.",
      "items": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "sibling_type_rules_out_null": {
      "description": "The sibling type string rules out the null entry: items are strings only.",
      "items": {
        "anyOf": [
          {
            "maxLength": 3
          },
          {
            "type": "null"
          }
        ],
        "type": "string"
      },
      "type": "array"
    },
    "required_alternatives_and_null": {
      "description": "Constraint-only anyOf plus a null entry still gives one combined row.",
      "items": {
        "anyOf": [
          {
            "required": [
              "a"
            ]
          },
          {
            "required": [
              "b"
            ]
          },
          {
            "type": "null"
          }
        ],
        "properties": {
          "a": {
            "type": "string"
          },
          "b": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "all_of_null_in_one_entry": {
      "description": "allOf needs every entry to allow null, so null is not allowed.",
      "items": {
        "allOf": [
          {
            "type": [
              "string",
              "null"
            ]
          },
          {
            "type": "string"
          }
        ]
      },
      "type": "array"
    },
    "one_of_null_in_two_entries": {
      "description": "null matches both oneOf entries, so oneOf rejects it.",
      "items": {
        "oneOf": [
          {
            "type": [
              "string",
              "null"
            ]
          },
          {
            "type": [
              "integer",
              "null"
            ]
          }
        ]
      },
      "type": "array"
    },
    "untyped_nested_nullable_lists": {
      "description": "Inner lists without a type keyword are still nested arrays.",
      "items": {
        "anyOf": [
          {
            "items": {
              "type": "string"
            }
          },
          {
            "type": "null"
          }
        ]
      },
      "type": "array"
    },
    "three_level_nested": {
      "description": "Three levels of arrays keep every level.",
      "items": {
        "items": {
          "type": "array"
        },
        "type": "array"
      },
      "type": "array"
    },
    "any_value_or_null": {
      "description": "An entry that accepts anything makes the items unrestricted.",
      "items": {
        "anyOf": [
          {},
          {
            "type": "null"
          }
        ]
      },
      "type": "array"
    },
    "duplicate_entries": {
      "description": "Entries that differ only in nullability are listed once.",
      "items": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": [
              "integer",
              "null"
            ]
          }
        ]
      },
      "type": "array"
    },
    "one_of_required_and_nullable_type": {
      "description": "null matches both required-only oneOf entries, so oneOf rejects it: items are objects only.",
      "items": {
        "oneOf": [
          {
            "required": [
              "a"
            ]
          },
          {
            "required": [
              "b"
            ]
          }
        ],
        "properties": {
          "a": {
            "type": "string"
          },
          "b": {
            "type": "string"
          }
        },
        "type": [
          "object",
          "null"
        ]
      },
      "type": "array"
    },
    "only_titled_null_entry": {
      "description": "A combinator holding only a null entry does not merge the item rows.",
      "items": {
        "anyOf": [
          {
            "title": "Nothing",
            "type": "null"
          }
        ],
        "properties": {
          "a": {
            "type": "string"
          },
          "b": {
            "type": "integer"
          }
        },
        "required": [
          "a"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "undescribable_or_null": {
      "description": "Options that cannot be described claim nothing, rather than only null.",
      "items": {
        "anyOf": [
          {
            "format": "date"
          },
          {
            "type": "null"
          }
        ]
      },
      "type": "array"
    },
    "format_alternatives_nullable_type": {
      "description": "format applies only to strings, so the anyOf does not rule out null.",
      "items": {
        "anyOf": [
          {
            "format": "date"
          },
          {
            "format": "date-time"
          }
        ],
        "type": [
          "string",
          "null"
        ]
      },
      "type": "array"
    }
  },
  "required": [
    "values"
  ],
  "title": "NullableArrays",
