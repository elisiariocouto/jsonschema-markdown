      "default": null,
      "description": "Optional[list[str]]: the array may be null, the items may not.",
      "title": "Optional Values"
    },
    "optional_values_nullable_items": {
      "anyOf": [
        {
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
